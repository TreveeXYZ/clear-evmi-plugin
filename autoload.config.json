    "stores": [
      {
        "identifier": "clickhouse-main",
        "description": "Raw indexed logs",
        "storeType": "clickhouse",
        "storeConfig": {
          "addr": "clickhouse:9000",
          "database": "evmi",
          "username": "default",
          "password": "",
          "logsTableName": "logs",
          "transactionsTableName": "transactions"
        }
      }
    ],
    "pipelines": [
      {
        "name": "clear",
        "blockchain": "sepolia",
        "store": "clickhouse-main"
      }
    ],
    "sources": [
      {
        "_comment": "Base reserve as a FACTORY: indexes its own events AND spawns a CONTRACT source (ClearIOU) for each IOU announced by AssetAdded.",
        "pipeline": "clear",
        "abi": "ClearBaseReserve",
        "type": "FACTORY",
        "enabled": true,
        "startBlock": 0,
        "address": "0x0000000000000000000000000000000000000001",
        "factoryChildAbi": "ClearIOU",
        "factoryCreationFunctionName": "AssetAdded",
        "factoryCreationAddressLogArg": "iou"
      },
      {
        "pipeline": "clear",
        "abi": "ClearMetaReserve",
        "type": "CONTRACT",
        "enabled": true,
        "startBlock": 0,
        "address": "0x0000000000000000000000000000000000000002"
      },
      {
        "pipeline": "clear",
        "abi": "CurveStableSwapNG",
        "type": "CONTRACT",
        "enabled": true,
        "startBlock": 0,
        "address": "0x0000000000000000000000000000000000000003"
      }
    ],
    "exporters": [
      {
        "name": "clear-defi",
        "pipeline": "clear",
        "plugin": "clear-defi",
        "enabled": true,
        "startBlock": 0,
        "pluginConfig": {
          "dsn": "postgres://evmi:secret@postgres:5432/clear?sslmode=disable",
          "autoMigrate": true
        }
      }
    ]
