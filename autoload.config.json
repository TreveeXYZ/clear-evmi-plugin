        "name": "sepolia",
        "chainId": 11155111,
        "rpcUrl": "https://sepolia.infura.io/v3/<KEY>",
        "blockRange": 500,
        "blockSlice": 5,
        "pullInterval": 5,
        "rpcMaxBatchSize": 100
      }
    ],
