{
  "_comment": "EVMI autoloader config for the Clear DeFi exporter. Replace every 0x…/<...> placeholder (RPC URL, reserve/pool addresses, start blocks, DSNs, plugin gitUrl) before use. Resources are created if absent on startup (idempotent).",
  "database": {
    "type": "POSTGRES",
    "config": {
      "dsn": "host=postgres user=evmi password=secret dbname=evmi port=5432 sslmode=disable"
    }
  },
  "metrics": {
    "enabled": true,
    "path": "/metrics",
    "port": 9999
  },
  "plugins": [
    {
      "name": "clear-defi",
      "description": "Clear protocol exporter (reserves, IOUs, curve pools)",
      "gitUrl": "https://github.com/<your-org>/clear-defi-exporter",
      "relativePath": "."
    }
  ],
  "resources": {
