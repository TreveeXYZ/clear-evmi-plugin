    "pipelines": [
      {
        "name": "clear",
        "blockchain": "sepolia",
        "store": "clickhouse-main"
      }
    ],
    "sources": [
      {
        "_comment": "ClearReserveFactory. NewClearReserve announces every reserve it deploys (base or meta); the exporter registers each one in clear_contracts from that log. It CANNOT be a FACTORY source: a factory source spawns children of a single ABI, and this one deploys two (ClearBaseReserve and ClearMetaReserve) — so each reserve still needs its own source entry below.",
        "pipeline": "clear",
        "abi": "ClearReserveFactory",
        "type": "CONTRACT",
        "enabled": true,
        "startBlock": 0,
        "address": "0x0000000000000000000000000000000000000006"
      },
      {
        "_comment": "Base reserve as a FACTORY: indexes its own events AND spawns a CONTRACT source (ClearIOU) for each IOU announced by AssetAdded.",
        "pipeline": "clear",
        "abi": "ClearBaseReserve",
        "type": "FACTORY",
        "enabled": true,
        "startBlock": 0,
        "address": "0x0000000000000000000000000000000000000001",
        "factoryChildAbi": "ClearIOU",
        "factoryCreationFunctionName": "AssetAdded",
        "factoryCreationAddressLogArg": "iou"
      },
      {
        "_comment": "Meta reserve, likewise a FACTORY: it now emits AssetAdded once per leg (native, then BaseLP) with that leg's IOU and target weight, so its two IOUs are spawned the same way.",
        "pipeline": "clear",
        "abi": "ClearMetaReserve",
        "type": "FACTORY",
        "enabled": true,
        "startBlock": 0,
        "address": "0x0000000000000000000000000000000000000002",
        "factoryChildAbi": "ClearIOU",
        "factoryCreationFunctionName": "AssetAdded",
        "factoryCreationAddressLogArg": "iou"
      },
      {
        "_comment": "ClearCurvePoolDeployer as a FACTORY: PoolDeployed announces every pool it deploys for a reserve (base pool and metapools), each spawned as a CurveStableSwapNG source. Pools deployed outside it still need their own CONTRACT source.",
        "pipeline": "clear",
        "abi": "ClearCurvePoolDeployer",
        "type": "FACTORY",
        "enabled": true,
        "startBlock": 0,
        "address": "0x0000000000000000000000000000000000000007",
        "factoryChildAbi": "CurveStableSwapNG",
        "factoryCreationFunctionName": "PoolDeployed",
        "factoryCreationAddressLogArg": "pool"
      },
      {
        "pipeline": "clear",
        "abi": "CurveStableSwapNG",
        "type": "CONTRACT",
        "enabled": true,
        "startBlock": 0,
        "address": "0x0000000000000000000000000000000000000003"
      },
      {
        "pipeline": "clear",
        "abi": "ClearOracle",
        "type": "CONTRACT",
        "enabled": true,
        "startBlock": 0,
        "address": "0x0000000000000000000000000000000000000004"
      },
      {
        "pipeline": "clear",
        "abi": "PythOracleAdapter",
        "type": "CONTRACT",
        "enabled": true,
        "startBlock": 0,
        "address": "0x0000000000000000000000000000000000000005"
      }
    ],
    "exporters": [
      {
        "name": "clear-defi",
        "pipeline": "clear",
        "plugin": "clear-defi",
        "enabled": true,
        "startBlock": 0,
        "pluginConfig": {
          "dsn": "postgres://evmi:secret@postgres:5432/clear?sslmode=disable",
          "autoMigrate": true,
          "_comment_contracts": "Address->kind registry seeded on Init. kind: base_reserve|meta_reserve|iou|curve|oracle|factory|curve_deployer. IOUs are discovered at AssetAdded, reserves at NewClearReserve and deployer-built pools at PoolDeployed, so those need not be listed. Match these to the source addresses above.",
          "contracts": [
            { "address": "0x0000000000000000000000000000000000000001", "kind": "base_reserve" },
            { "address": "0x0000000000000000000000000000000000000002", "kind": "meta_reserve" },
            { "address": "0x0000000000000000000000000000000000000003", "kind": "curve" },
            { "address": "0x0000000000000000000000000000000000000004", "kind": "oracle" },
            { "address": "0x0000000000000000000000000000000000000005", "kind": "oracle" },
            { "address": "0x0000000000000000000000000000000000000006", "kind": "factory" },
            { "address": "0x0000000000000000000000000000000000000007", "kind": "curve_deployer" }
          ]
        }
      }
    ]
  }
}
